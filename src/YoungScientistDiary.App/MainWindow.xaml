<Window x:Class="YoungScientistDiary.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Дневник молодого ученого" Width="1400" Height="900" MinWidth="1040" MinHeight="680" WindowStartupLocation="CenterScreen">
 <Grid>
  <Grid.ColumnDefinitions><ColumnDefinition Width="218"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border Background="#142C40"><DockPanel Margin="16,24,12,16">
   <StackPanel DockPanel.Dock="Top" Margin="6,0,0,28"><TextBlock Text="ДНЕВНИК" FontSize="24" FontWeight="Bold" Foreground="White"/><TextBlock Text="молодого ученого" Foreground="#A9CFD5" FontSize="15"/><TextBlock Text="Исследуйте. Сохраняйте.&#x0a;Возвращайтесь к результатам." FontSize="12" Foreground="#91AABB" Margin="0,16,0,0"/></StackPanel>
   <StackPanel DockPanel.Dock="Bottom"><TextBlock Text="Версия 1.0 • .NET 8" Foreground="#91AABB" FontSize="11" Margin="6,8"/><TextBlock Text="Локальное рабочее пространство" Foreground="#91AABB" FontSize="11" Margin="6,0"/></StackPanel>
   <StackPanel x:Name="NavigationPanel"/>
  </DockPanel></Border>
  <Grid Grid.Column="1" Margin="28,20,24,12">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <DockPanel Margin="0,0,0,12"><TextBox x:Name="SearchBox" DockPanel.Dock="Right" Width="280" ToolTip="Поиск по проектам, записям, задачам и литературе. Enter — найти." KeyDown="SearchBox_KeyDown"/><StackPanel Orientation="Horizontal"><TextBlock Text="ПРОЕКТ" FontSize="11" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,12,6"/><ComboBox x:Name="ProjectSelector" Width="340" DisplayMemberPath="Label" SelectedValuePath="Value" SelectionChanged="ProjectSelector_SelectionChanged"/></StackPanel></DockPanel>
   <StackPanel Grid.Row="1" Margin="0,0,0,18"><TextBlock x:Name="PageTitle" FontSize="28" FontWeight="SemiBold"/><TextBlock x:Name="PageSubtitle" Foreground="{DynamicResource MutedBrush}" Margin="0,6,0,0"/></StackPanel>
   <ContentControl x:Name="MainContent" Grid.Row="2" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
   <DockPanel Grid.Row="3" Margin="0,12,0,0"><TextBlock x:Name="BackupStatus" DockPanel.Dock="Right" FontSize="11" Foreground="{DynamicResource MutedBrush}"/><TextBlock x:Name="StatusText" FontSize="11" Foreground="{DynamicResource MutedBrush}" Text="Готово"/></DockPanel>
  </Grid>
 </Grid>
</Window>
